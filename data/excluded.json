    "selection_status": "excluded"
  },
  {
    "id": "7b58793327899acec700710906ee01d1",
    "title": "凉州乐二首",
    "authorName": "温子昇",
    "authorId": "7b58793327899ace35051070c75b6f11",
    "dynasty": "南北朝",
    "content": [
      "【其一】",
      "远游武威郡，遥望姑臧城。",
      "车马相交错，歌吹日纵横。",
      "【其二】",
      "路出玉门关，城接龙城坂。",
      "但事弦歌乐，谁道山川远！"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b58793327899aced3ced17f92b80f14",
    "title": "白鼻騧",
    "authorName": "温子昇",
    "authorId": "7b58793327899ace35051070c75b6f11",
    "dynasty": "南北朝",
    "content": [
      "少年多好事，揽辔向西都。相逢狭斜路，驻马诣当垆。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b58793327899ace71bc887a56a96364",
    "title": "结袜子",
    "authorName": "温子昇",
    "authorId": "7b58793327899ace35051070c75b6f11",
    "dynasty": "南北朝",
    "content": [
      "谁能访故剑，会自逐前鱼。",
      "裁纫终委箧，织素空有馀。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b58793327899acef7b2125c62cda68c",
    "title": "安定侯曲",
    "authorName": "温子昇",
    "authorId": "7b58793327899ace35051070c75b6f11",
    "dynasty": "南北朝",
    "content": [
      "封疆在上地，钟鼓自相和。",
      "美人当窗舞，妖姬掩扇歌。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b58793327899acea00f214e0c960bec",
    "title": "炖煌乐",
    "authorName": "温子昇",
    "authorId": "7b58793327899ace35051070c75b6f11",
    "dynasty": "南北朝",
    "content": [
      "客从远方来，相随歌且笑。",
      "自有炖煌乐，不减安陵调。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b58793327899ace60118ebd34e7e9ed",
    "title": "捣衣诗",
    "authorName": "温子昇",
    "authorId": "7b58793327899ace35051070c75b6f11",
    "dynasty": "南北朝",
    "content": [
      "长安城中秋夜长，佳人锦石捣流黄。",
      "香杵纹砧知近远，传声递响何凄凉。",
      "七夕长河烂，中秋明月光。",
      "蠮螉塞边绝候雁，鸳鸯楼上望天狼。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b58793327899aced815769de8bc3505",
    "title": "从驾幸金墉城诗",
    "authorName": "温子昇",
    "authorId": "7b58793327899ace35051070c75b6f11",
    "dynasty": "南北朝",
    "content": [
      "兹城实佳丽，飞甍自相并。",
      "胶葛拥行风，岧峣閟流景。",
      "御沟属清洛，驰道通丹屏。",
      "湛淡水成文，参差树交影。",
      "长门久已闭，离宫一何静。",
      "细草缘玉阶，高枝荫桐井。",
      "微微夕渚暗，肃肃暮风冷。",
      "神行扬翠旗，天临肃清警。",
      "伊臣从下列，逢恩信多幸。",
      "康衢虽已泰，弱力将安骋。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b58793327899ace62195a8d0671741b",
    "title": "春日临池诗",
    "authorName": "温子昇",
    "authorId": "7b58793327899ace35051070c75b6f11",
    "dynasty": "南北朝",
    "content": [
      "光风动春树，丹霞起暮阴。",
      "嵯峨映连璧，飘飖下散金。",
      "徒自临濠渚，空复抚鸣琴。",
      "莫知流水曲，谁辩游鱼心。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b58793327899ace8cc8bbc25204f9f5",
    "title": "咏花蝶诗",
    "authorName": "温子昇",
    "authorId": "7b58793327899ace35051070c75b6f11",
    "dynasty": "南北朝",
    "content": [
      "素蝶向林飞，红花逐风散。",
      "花蝶俱不息，红素还相乱。",
      "芬芬共袭予，葳蕤从可玩。",
      "不慰行客心，遽动离居叹。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b58793327899acec5eca2c3cd94b393",
    "title": "相国清河王挽歌",
    "authorName": "温子昇",
    "authorId": "7b58793327899ace35051070c75b6f11",
    "dynasty": "南北朝",
    "content": [
      "高门讵改辙，曲沼尚馀波。",
      "何言吹楼下，翻成薤露歌。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b587933412abef622da67d44864f1e3",
    "title": "思公子",
    "authorName": "邢邵",
    "authorId": "7b587933412abef6b534ba68d1457b72",
    "dynasty": "南北朝",
    "content": [
      "绮罗日减带，桃李无颜色。",
      "思君君未归，归来岂相识。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b587933412abef6b8ab3981ee19cfb8",
    "title": "七夕诗",
    "authorName": "邢邵",
    "authorId": "7b587933412abef6b534ba68d1457b72",
    "dynasty": "南北朝",
    "content": [
      "盈盈河水侧，朝朝长叹息。",
      "不吝渐衰苦，波流讵可测。",
      "秋期忽云至，停梭理容色。",
      "束衿未解带，回銮已沾轼。",
      "不见眼中人，谁堪机上织。",
      "愿逐青鸟去，暂因希羽翼。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b5879334eab2e3c777b7d98cf81c1b9",
    "title": "腊节",
    "authorName": "魏收",
    "authorId": "7b5879334eab2e3cff4d5fbbe6b4b2a7",
    "dynasty": "南北朝",
    "content": [
      "凝寒迫清祀，有酒宴嘉平。",
      "宿心何所道，藉此慰中情。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b5879335b883b2b80d9f7bbaadda791",
    "title": "春日诗",
    "authorName": "阳休之",
    "authorId": "7b5879335b883b2be2230b8546922a08",
    "dynasty": "南北朝",
    "content": [
      "迟迟暮春日，霭霭春光上。",
      "柔露洗金盘，轻丝缀珠网。",
      "渐看阶茝蔓，稍觉池莲长。",
      "蝴蝶映花飞，楚雀缘条响。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b5879335b883b2bffc98a7e334f4e9f",
    "title": "咏萱草诗",
    "authorName": "阳休之",
    "authorId": "7b5879335b883b2be2230b8546922a08",
    "dynasty": "南北朝",
    "content": [
      "开跗幽涧底，散彩曲堂垂。",
      "优柔清露湿，微穆惠风吹。",
      "朝朝含丽景，夜夜对华池。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b5879335b883b2b75b8ad497245ae42",
    "title": "正月七日登高侍宴二首",
    "authorName": "阳休之",
    "authorId": "7b5879335b883b2be2230b8546922a08",
    "dynasty": "南北朝",
    "content": [
      "【其一】",
      "日照前窗竹，露湿后园薇。",
      "夜蛩扶砌响，轻蛾绕烛飞。",
      "【其二】",
      "广殿丽年辉，上林起春色。",
      "风生拂雕辇，云回浮绮翼。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b58793374cb58233ef46f82c8b4cf25",
    "title": "山家闺怨诗",
    "authorName": "李爽",
    "authorId": "7b58793374cb5823d1457b72d1457b72",
    "dynasty": "南北朝",
    "content": [
      "山中多早梅，荆扉达曙开。",
      "竹巾君自折，荷衣谁为裁。",
      "行云无处所，人住在阳台。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  },
  {
    "id": "7b58793374cb5823ca6084312b4c7d0b",
    "title": "芳树",
    "authorName": "李爽",
    "authorId": "7b58793374cb5823d1457b72d1457b72",
    "dynasty": "南北朝",
    "content": [
      "芳树千株发，摇荡三阳时。",
      "气软来风易，枝繁度鸟迟。",
      "春至花如锦，夏近叶成帷。",
      "欲寄边城客，路远谁能持。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "excluded"
  }
]
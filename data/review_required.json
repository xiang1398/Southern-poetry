  {
    "id": "7b587933a644b67c70819476c8894ef4",
    "title": "怨歌行",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "家住金陵县前，嫁得长安少年。",
      "回头望乡泪落，不知何处天边。",
      "胡尘几日应尽，汉月何时更圆。",
      "为君能歌此曲，不觉心随断弦。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67cd592e1c9d2f70493",
    "title": "结客少年场行",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "结客少年场，春风满路香。",
      "歌撩李都尉，果掷潘河阳。",
      "隔花遥劝酒，就水更移床。",
      "今年喜夫婿，新拜羽林郎。",
      "定知刘碧玉，偷嫁汝南王。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67c4ece0f182c0b9c4c",
    "title": "出自蓟北门行",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "蓟门还北望，役役尽伤情。",
      "关山连汉月，陇水向秦城。",
      "笳寒芦叶脆，弓冻纻弦鸣。",
      "梅林能止渴，复姓可防兵。",
      "将军朝挑战，都护夜巡营。",
      "燕山犹有石，须勒几人名。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67c6b7b8f6324e16b68",
    "title": "至仁山铭",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "峰横鹤岭，水学龙津。瑞云一片，仙童两人。三秋云薄，九日寒新。真花暂落，画树长春。横石临砌，飞檐枕岭。壁绕藤苗，窗衔竹影。菊落秋潭，桐疏寒井。仁者可乐，将由爱静。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67c8f56001e6abd9288",
    "title": "梦入堂内诗",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "雕梁旧刻杏，香壁本泥椒。",
      "幔绳金麦穗，帘钩银蒜条。",
      "画眉千度拭，梳头百遍撩。",
      "小衫裁裹臂，缠弦搯抱腰。",
      "日光钗燄动，窗影镜花摇。",
      "歌曲风吹韵，笙簧火炙调。",
      "即今须戏去，谁复待明朝。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67c4d8e9468e5f6c6b3",
    "title": "奉和山池诗",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "乐官多暇豫，望苑暂回舆。",
      "鸣笳陵绝限，飞盖历通渠。",
      "桂亭花未落，桐门叶半疏。",
      "荷风惊浴鸟，桥影聚行鱼。",
      "日落含山气，云归带雨馀。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67c20dd773970d2de2b",
    "title": "寻周处士弘让诗",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "试逐赤松游，披林对一丘。",
      "梨红大谷晚，桂白小山秋。",
      "石镜菱花发，桐门琴曲愁。",
      "泉飞疑度雨，云积似重楼。",
      "王孙若不去，山中定可留。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67c343d4301af360818",
    "title": "集周公处连句诗",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "市朝一朝变，兰艾本同焚。",
      "故人相借问，平生如所闻。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67c5ed377717e4e52fe",
    "title": "望渭水诗",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "树似新亭岸，沙如龙尾湾。",
      "犹言吟暝浦，应有落帆还。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67cef40c36290b8824a",
    "title": "和刘仪同臻诗",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "南登广陵岸，回首落星城。",
      "不言临旧浦，烽火照江明。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67c8212f4e93c01de14",
    "title": "秋日诗",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "苍茫望落景，羁旅对穷秋。",
      "赖有南园菊，残花足解愁。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67cb0144a02a906e7c6",
    "title": "秋夜望单飞雁",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "失群寒雁声可怜，夜半单飞在月边。",
      "无奈人心复有忆，今暝将渠俱不眠。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67cb8c99ff47aaabaf6",
    "title": "燕歌行",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "代北云气昼昏昏，千里飞蓬无复根。",
      "寒雁丁丁渡辽水，桑叶纷纷落蓟门。",
      "晋阳山头无箭竹，疏勒城中乏水源。",
      "属国征戍久离居，阳关音信绝能疏。",
      "愿得鲁连飞一箭，持寄思归燕将书。",
      "渡辽本自有将军，寒风萧萧生水纹。",
      "妾惊甘泉足烽火，君讶渔阳少阵云。",
      "自从将军出细柳，荡子空床难独守。",
      "盘龙明镜饷秦嘉，辟恶生香寄韩寿。",
      "春分燕来能几日，二月蚕眠不复久。",
      "洛阳游丝百丈连，黄河春冰千片穿。",
      "桃花颜色好如马，榆荚新开巧似钱。",
      "蒲桃一杯千日醉，无事九转学神仙。",
      "定取金丹作几服，能令华表得千年。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67c5ff84c99e262e98c",
    "title": "春望诗",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "春望上春台，春窗四面开。",
      "落花何假拂，风吹会并来。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67c96477a383ab6852b",
    "title": "对酒歌",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "春水望桃花，春洲藉芳杜。",
      "琴从绿珠借，酒就文君取。",
      "牵马向渭桥，日曝山头脯。",
      "山简接䍦倒，王戎如意舞。",
      "筝鸣金谷园，笛韵平阳坞。",
      "人生一百年，欢笑惟三五。",
      "何处觅钱刀，求为洛阳贾。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a296ca3c096e57ae4549",
    "title": "木兰诗",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "唧唧复唧唧，木兰当户织。不闻机杼声，惟闻女叹息。",
      "问女何所思，问女何所忆。女亦无所思，女亦无所忆。昨夜见军帖，可汗大点兵，军书十二卷，卷卷有爷名。阿爷无大儿，木兰无长兄，愿为市鞍马，从此替爷征。东市买骏马，西市买鞍鞯，南市买辔头，北市买长鞭。旦辞爷娘去，暮宿黄河边，不闻爷娘唤女声，但闻黄河流水鸣溅溅。旦辞黄河去，暮至黑山头，不闻爷娘唤女声，但闻燕山胡骑鸣啾啾。",
      "万里赴戎机，关山度若飞。朔气传金柝，寒光照铁衣。将军百战死，壮士十年归。归来见天子，天子坐明堂。策勋十二转，赏赐百千强。可汗问所欲，木兰不用尚书郎；愿驰千里足，送儿还故乡。",
      "爷娘闻女来，出郭相扶将；阿姊闻妹来，当户理红妆；小弟闻姊来，磨刀霍霍向猪羊。开我东阁门，坐我西阁床，脱我战时袍，著我旧时裳，当窗理云鬓，对镜贴花黄。出门看火伴，火伴皆惊忙：同行十二年，不知木兰是女郎。",
      "雄兔脚扑朔，雌兔眼迷离；双兔傍地走，安能辨我是雄雌？"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a2960b2c7bb21e812265",
    "title": "敕勒歌",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "敕勒川，阴山下。",
      "天似穹庐，笼盖四野。",
      "天苍苍，野茫茫，",
      "风吹草低见牛羊。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a2966a000dff08aeae28",
    "title": "西洲曲",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "忆梅下西洲，折梅寄江北。",
      "单衫杏子红，双鬓鸦雏色。",
      "西洲在何处？两桨桥头渡。",
      "日暮伯劳飞，风吹乌臼树。",
      "树下即门前，门中露翠钿。",
      "开门郎不至，出门采红莲。",
      "采莲南塘秋，莲花过人头。",
      "低头弄莲子，莲子青如水。",
      "置莲怀袖中，莲心彻底红。",
      "忆郎郎不至，仰首望飞鸿。",
      "鸿飞满西洲，望郎上青楼。",
      "楼高望不见，尽日栏杆头。",
      "栏杆十二曲，垂手明如玉。",
      "卷帘天自高，海水摇空绿。",
      "海水梦悠悠，君愁我亦愁。",
      "南风知我意，吹梦到西洲。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a296c10c7ccdaeb299a2",
    "title": "折杨柳歌辞",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "【其一】",
      "上马不捉鞭，反折杨柳枝。",
      "蹀座吹长笛，愁杀行客儿。",
      "【其二】",
      "腹中愁不乐，愿作郎马鞭。",
      "出入擐郎臂，蹀座郎膝边。",
      "【其三】",
      "放马两泉泽，忘不著连羁。",
      "担鞍逐马走，何见得马骑。",
      "【其四】",
      "遥看孟津河，杨柳郁婆娑。",
      "我是虏家儿，不解汉儿歌。",
      "【其五】",
      "健儿须快马，快马须健儿。",
      "跸跋黄尘下，然后别雄雌。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a29652f1e41007e22d2e",
    "title": "陇头流水歌辞三首",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "【其一】",
      "陇头流水，流离山下。念吾一身，飘然旷野。",
      "【其二】",
      "朝发欣城，暮宿陇头。寒不能语，舌卷入喉。",
      "【其三】",
      "陇头流水，鸣声幽咽。遥望秦川，心肝断绝。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a29697c51878c95de23b",
    "title": "陇上歌",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "陇上壮士有陈安，躯干虽小腹中宽，爱养将士同心肝。",
      "骣骢父马铁锻鞍，七尺大刀奋如湍，丈八蛇矛左右盘，十荡十决无当前。",
      "百骑俱出如云浮，追者千万骑悠悠。",
      "战始三交失蛇矛，十骑俱荡九骑留。",
      "弃我骣骢窜岩幽，天降大雨追者休，为我外援而悬头。",
      "西流之水东流河，一去不还奈子何！",
      "阿呼呜呼奈子乎，呜呼阿呼奈子何！"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a29682b3185431090139",
    "title": "地驱乐歌",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "月明光光星欲堕，欲来不来早语我。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a296bd419a101c9b4e01",
    "title": "地驱歌乐辞",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "青青黄黄，雀石颓唐。槌杀野牛，押杀野羊。",
      "驱羊入谷，白羊在前。老女不嫁，蹋地唤天。",
      "侧侧力力，念君无极。枕郎左臂，随郎转侧。",
      "摩捋郎须，看郎颜色。郎不念女，不可与力。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a296b98db33abfc1966d",
    "title": "子夜四时歌之夏歌二十首",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "高堂不作壁，招取四面风。吹欢罗裳开，动侬含笑容。",
      "反复华簟上，屏帐了不施。郎君未可前，等我整容仪。",
      "开春初无欢，秋冬更增凄。共戏炎暑月，还觉两情谐。",
      "春别犹春恋，夏还情更久。罗帐为谁褰，双枕何时有？",
      "叠扇放床上，企想远风来。轻袖拂华妆，窈窕登高台。",
      "含桃已中食，郎赠合欢扇。深感同心意，兰室期相见。",
      "田蚕事已毕，思妇犹苦身。当暑理絺服，持寄与行人。",
      "朝登凉台上，夕宿兰池里。乘月采芙蓉，夜夜得莲子。",
      "暑盛静无风，夏云薄暮起。携手密叶下，浮瓜沉朱李。",
      "郁蒸仲暑月，长啸出湖边。芙蓉始结叶，花艳未成莲。",
      "适见戴青幡，三春已复倾。林鹊改初调，林中夏蝉鸣。",
      "春桃初发红，惜色恐侬擿。朱夏花落去，谁复相寻觅。",
      "昔别春风起，今还夏云浮。路遥日月促，非是我淹留。",
      "青荷盖渌水，芙蓉葩红鲜。郎见欲采我，我心欲怀莲。",
      "四周芙蓉池，朱堂敝无壁。珍簟镂玉床，缱绻任怀适。",
      "赫赫盛阳月，无侬不握扇。窈窕瑶台女，冶游戏凉殿。",
      "春倾桑叶尽，夏开蚕务毕。昼夜理机缚，知欲早成匹。",
      "情知三夏熬，今日偏独甚。香巾拂玉席，共郎登楼寝。",
      "轻衣不重彩，飙风故不凉。三伏何时过，许侬红粉妆。",
      "盛暑非游节，百虑相缠绵。泛舟芙蓉湖，散思莲子间。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a296f6162833661518bb",
    "title": "子夜四时歌之秋歌十八首",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "风清觉时凉，明月天色高。佳人理寒服，万结砧杵劳。",
      "清露凝如玉，凉风中夜发。情人不还卧，冶游步明月。",
      "鸿雁搴南去，乳燕指北飞。征人难为思，愿逐秋风归。",
      "开窗秋月光，灭烛解罗裳。合笑帷幌里，举体兰蕙香。",
      "适忆三阳初，今已九秋暮。追逐泰始乐，不觉华年度。",
      "飘飘初秋夕，明月耀秋辉。握腕同游戏，庭含媚素归。",
      "秋夜凉风起，天高星月明。兰房竞妆饰，绮帐待双情。",
      "凉秋开窗寝，斜月垂光照。中宵无人语，罗幌有双笑。",
      "金风扇素节，玉露凝成霜。登高去来雁，惆怅客心伤。",
      "草木不常荣，憔悴为秋霜。今遇泰始世，年逢九春阳。",
      "自从别欢来，何日不相思。常恐秋叶零，无复莲条时。",
      "掘作九州池，尽是大宅里。处处种芙蓉，婉转得莲子。",
      "初寒八九月，独缠自络丝。寒衣尚未了，郎唤侬底为？",
      "秋爱两两雁，春感双双燕。兰鹰接野鸡，雉落谁当见？",
      "仰头看桐树，桐花特可怜。愿天无霜雪，梧子结千年。",
      "白露朝夕生，秋风凄长夜。忆郎须寒服，乘月捣白素。",
      "秋风入窗里，罗帐起飘扬。仰头看明月，寄情千里光。",
      "别在三阳初，望还九秋暮。恶见东流水，终年不西顾。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a296488f7d29472b2c68",
    "title": "陈留章武歌",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "陈留章武，伤腰折股。",
      "贪人败类，秽我明主。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a2964df965ccf1011369",
    "title": "狐非狐歌",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "狐非狐，貉非貉，焦梨狗子啮断索。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a296dcceaee57306771d",
    "title": "青雀子歌",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "可怜青雀子，飞入邺城里。",
      "作巢犹未成，举头失乡里。",
      "寄言与父母，看好新妇子。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a296abcadd7ad61657c5",
    "title": "三洲歌",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "送欢权桥梁，相待三山头。",
      "遥见千福帆，知是逐风流。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a296305ecd06d6886185",
    "title": "乌夜啼",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "远望千里烟，隐当在欢家。",
      "欲飞无两翅，当奈独思何。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a2961ca47b65f15b50f5",
    "title": "青溪小姑曲",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "开门白水，侧近桥梁。小姑所居，独处无郎。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a2962604446ead5e742b",
    "title": "白石郎曲",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "白石郎，临江居。前导江伯后从鱼。",
      "积石如玉，列松如翠。郎艳独绝，世无其二。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a296ee875a085cc9232f",
    "title": "宿阿曲",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "苏林开天门，赵尊闭地户。",
      "神灵亦道同，真官今来下。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a29696aaf540d6f957f3",
    "title": "道君曲",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "中庭有树，自语梧桐，推枝布叶。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a296ded5a97e76160480",
    "title": "圣郎曲",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "左亦不佯佯，右亦不翼翼。仙人在郎旁，玉女在郎侧。酒无沙糖味，为他同颜色。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a2966e65bca562c9f85a",
    "title": "娇女诗",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "北游临河海，遥望中菰菱。",
      "芙蓉发盛华，渌水清且澄。",
      "弦歌奏声节，仿佛有余音。",
      "蹀躞越桥上，河水东西流。",
      "上有神仙居，下有西流鱼。",
      "行不独自去，三三两两俱。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a296a5d14ace92b3098d",
    "title": "湖就姑曲",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "赤山湖就头，孟阳二三月，绿蔽贲荇薮。",
      "湖就赤山矶，大姑大湖东，仲姑居湖西。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a2963a8de14cb643a862",
    "title": "姑恩曲",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "明姑遵八风，藩霭云日中，前导陆离兽，后从朱鸟麟凤凰。",
      "苕苕山头柏，冬夏叶不衰。独当被天恩，枝叶华葳蕤。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a2964adb342defa96725",
    "title": "采莲童曲",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "【其一】",
      "泛舟采菱叶，过摘芙蓉花。",
      "扣楫命童侣，齐声采莲歌。",
      "【其二】",
      "东湖扶菰童，西湖采菱芰。",
      "不持歌作乐，为持解愁思。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a2968c82b1aaa0b75068",
    "title": "明下童",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "走马上前阪，石子弹马蹄。不惜弹马蹄，但惜马上儿。",
      "陈孔骄赭白，路郎乘班骓。徘徊射堂头，望门不欲归。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a2965d5c230be2a27b99",
    "title": "同生曲",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "人生不满百，常抱千岁忧。",
      "早知人命促，秉烛夜行游。",
      "岁月如流迈，行已及素秋。",
      "蟋蟀鸣空堂，感怅令人忧。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a2966bf6319fc58b004f",
    "title": "懊侬歌",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "江陵去扬州，三千三百里。",
      "已行一千三，还有二千在。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a2966bf6319f8ae37edc",
    "title": "懊侬歌",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "我与欢相怜，约誓底言者？常叹负情人，郎今果成诈。",
      "月落天欲曙，能得几时眠。凄凄下床去，侬病不能言。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933b1c2a296963fff4084e0d614",
    "title": "读曲歌",
    "authorName": "无名氏",
    "authorId": "7b587933b1c2a296d41d8cd9d41d8cd9",
    "dynasty": "南北朝",
    "content": [
      "打杀长鸣鸡，弹去乌臼鸟。愿得连冥不复曙，一年都一晓。",
      "一夕就郎宿，通夜语不息。黄蘖万里路，道苦真无极。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933d4d46b89cf94893561613bfe",
    "title": "咏兰诗",
    "authorName": "萧詧",
    "authorId": "7b587933d4d46b8963538fe64e4b5fbb",
    "dynasty": "南北朝",
    "content": [
      "折茎聊可佩，入室自成芳。",
      "开花不竞节，含秀委微霜。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  }
]
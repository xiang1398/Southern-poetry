  {
    "id": "7b587933a644b67cad8a23f69bd53332",
    "title": "舞媚娘",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "朝来户前照镜，含笑盈盈自看。",
      "眉心浓黛直点，额角轻黄细安。",
      "只疑落花慢去，复道春风不还。",
      "少年唯有欢乐，饮酒那得留残。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67cc6201ec892eedb01",
    "title": "代人伤往诗二首",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "【其一】",
      "青田松上一黄鹤，相思树下两鸳鸯。",
      "无事交渠更相失，不及从来莫作双。",
      "【其二】",
      "杂树本唯金谷苑，诸花旧满洛阳城。",
      "正是古来歌舞处，今日看时无地行。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
  },
  {
    "id": "7b587933a644b67c305ecd06b2939349",
    "title": "乌夜啼",
    "authorName": "庾信",
    "authorId": "7b587933a644b67c3dc4876fc6e19e83",
    "dynasty": "南北朝",
    "content": [
      "促柱繁弦非《子夜》，歌声舞态异《前溪》。",
      "御史府中何处宿，洛阳城头那得栖。",
      "弹琴蜀郡卓家女，织锦秦川窦氏妻。",
      "讵不自惊长泪落，到头啼乌恒夜啼。"
    ],
    "source_repository": "snowtraces/poetry-source",
    "source_path": "source/诗/南北朝/poetry.南北朝.0000.base.json",
    "selection_status": "review"
